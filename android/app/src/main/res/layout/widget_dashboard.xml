<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#2F2118"
    android:textSize="16sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#735F50"
    android:textSize="11sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/metric_one"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="5dp"
      android:layout_weight="1"
      android:background="@drawable/widget_chip"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="#2F2118"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/metric_two"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="5dp"
      android:layout_weight="1"
      android:background="@drawable/widget_chip"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="#2F2118"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/metric_three"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_chip"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:textColor="#2F2118"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/recent_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#735F50"
    android:textSize="12sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/action_product"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_chip"
      android:gravity="center"
      android:text="원두"
      android:textColor="#2F2118"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/action_lot"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_chip"
      android:gravity="center"
      android:text="구매"
      android:textColor="#2F2118"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/action_brew"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_button"
      android:gravity="center"
      android:text="추출"
      android:textColor="#FFFFFF"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
